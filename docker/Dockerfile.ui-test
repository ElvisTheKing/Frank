FROM rust:1.92.0-bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        dbus-x11 \
        fonts-dejavu-core \
        libgl1-mesa-dri \
        libudev-dev \
        libvulkan1 \
        libwayland-dev \
        libx11-dev \
        libx11-xcb-dev \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxrandr2 \
        libxcb-render0-dev \
        libxcb-shape0-dev \
        libxcb-xfixes0-dev \
        libxkbcommon-dev \
        libxkbcommon-x11-dev \
        mesa-vulkan-drivers \
        pkg-config \
        vulkan-tools \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt \
    && rustup target add wasm32-unknown-unknown \
    && cargo install egui_mcp --version 0.1.0 --locked

COPY docker/ui-test-entrypoint.sh /usr/local/bin/frank-ui-test
RUN chmod +x /usr/local/bin/frank-ui-test

WORKDIR /workspace

CMD ["frank-ui-test"]
